{
  "extends": "@react-native/typescript-config",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@assets": ["./src/assets"],
      "@components": ["./src/components"],
      "@hooks": ["./src/hooks"],
      "@lib": ["./src/lib"],
      "@screens": ["./src/screens"],
      "@services": ["./src/services"],
      "@theme": ["./src/theme"],
      "@types": ["./src/types"],
    }
  }
}
