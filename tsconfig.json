{
  "extends": "@react-native/typescript-config",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@assets": ["./src/assets"],
      "@components": ["./src/components"],
      "@screens": ["./src/screens"],
      "@theme": ["./src/theme"],
    }
  }
}
